# 只放变量名与说明，绝不放值。真实 .env 已在 .gitignore 中屏蔽。
# 违反者按《项目维护约束 v2》2.4 误提交应急流程处理（先轮换凭证，再清历史）。

# ---- 运行环境 ----
PROJECT_ENV=            # local | cloudlab | ci
RANDOM_SEED_POOL=       # 逗号分隔，例 11,22,33,44,55；禁止在代码内硬编码种子

# ---- 两侧端点（禁止把两侧变量同时写进同一份真实 .env）----
PARTY_CN_ENDPOINT=      # 内地侧服务地址，占位
PARTY_HK_ENDPOINT=      # 香港侧服务地址，占位

# ---- 数据位置（数据本身永不入库）----
DATA_ROOT=              # 本地数据根目录的绝对路径
SYNTHETIC_OUT=          # 合成数据输出目录（不提交，可由生成器+config+seed 重建）

# ---- 审计与治理 ----
AUDIT_LOG_DIR=          # 跨境调用审计日志落盘目录（运行时产物，不进 git）
CONSENT_BATCH_ID=       # 当前使用的同意批次标识
