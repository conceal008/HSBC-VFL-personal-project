"""Frozen source admission, narrow capabilities, and remote cleanup failure controls."""

from pathlib import Path
import json
import subprocess
import sys
from types import SimpleNamespace
import pytest
import yaml

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "components"))
import portfolio_endpoint_vm as p  # noqa: E402


@pytest.fixture
def source(tmp_path, monkeypatch):
    cfg = yaml.safe_load(p.CONFIG.read_text())
    repo = tmp_path / "repo"
    original = p.REPOSITORY / cfg["source_config"]
    copied = repo / cfg["source_config"]
    copied.parent.mkdir(parents=True)
    copied.write_bytes(original.read_bytes())
    monkeypatch.setattr(p, "REPOSITORY", repo)
    root = tmp_path / "homecredit/homecredit_portfolio_aggregate_20261015T123456Z"
    (root / "alice/code").mkdir(parents=True)
    (root / "alice/results").mkdir()
    phases = {}
    for seed in cfg["shared"]["model_seeds"]:
        stage = root.parent / f"homecredit_seed{seed}_phase"
        stage.mkdir()
        p.save(
            stage / "status.json",
            dict(status="passed", exit_codes=[0, 0], cleanup_errors=[]),
        )
        phases[str(seed)] = str(stage)
    p.save(root / "phase_declaration.json", dict(phases=phases))
    p.save(
        root / "status.json", dict(status="passed", exit_codes=[0], cleanup_errors=[])
    )
    code = root / "alice/code"
    (code / "nonlinear_full.yaml").write_bytes(copied.read_bytes())
    hashes = {}
    for name in p.source_provider.CODE + p.phase.CONTROLLERS:
        (code / name).write_bytes((p.MODULE / "components" / name).read_bytes())
        hashes[name] = p.sha(code / name)
    p.save(
        root / "alice/results/private_feature_evaluation.json",
        {"synthetic": "aggregate only"},
    )
    old = dict(
        party="alice",
        dataset="homecredit",
        config="/previous/nonlinear_full.yaml",
        config_sha256=cfg["source_config_sha256"],
        code_sha256={n: hashes[n] for n in p.source_provider.CODE},
        controller_sha256={n: hashes[n] for n in p.phase.CONTROLLERS},
    )
    p.save(code / "runtime.json", old)
    ref = repo / cfg["source_results_directory"] / "homecredit.json"
    ref.parent.mkdir(parents=True)
    p.save(
        ref,
        dict(
            dataset="homecredit",
            step=cfg["source_step"],
            config_provenance=dict(config_sha256=old["config_sha256"]),
            source_summary_sha256=p.sha(
                root / "alice/results/private_feature_evaluation.json"
            ),
        ),
    )
    return root, cfg


def test_source_requires_complete_five_seed_protocol_and_current_source(source):
    root, cfg = source
    assert p.source_description(root, cfg)[0] == "homecredit"


@pytest.mark.parametrize(
    "fault",
    [
        "identity",
        "failed",
        "phase_missing",
        "phase_failed",
        "phase_owner",
        "runtime",
        "code",
        "summary",
    ],
)
def test_source_rejects_partial_or_changed_frozen_inputs(source, fault):
    root, cfg = source
    if fault == "identity":
        root = root.parent / "wrong"
    elif fault == "failed":
        state = p.read(root / "status.json")
        state["status"] = "failed"
        p.save(root / "status.json", state)
    elif fault.startswith("phase"):
        file = root / "phase_declaration.json"
        state = p.read(file)
        if fault == "phase_missing":
            state["phases"].pop("11")
        elif fault == "phase_owner":
            state["phases"]["11"] = "/wrong/wrong_seed11_phase"
        else:
            target = Path(state["phases"]["11"]) / "status.json"
            s = p.read(target)
            s["cleanup_errors"] = ["failure"]
            p.save(target, s)
        p.save(file, state)
    elif fault == "runtime":
        file = root / "alice/code/runtime.json"
        state = p.read(file)
        state["party"] = "bob"
        p.save(file, state)
    elif fault == "code":
        (root / "alice/code/portfolio_math.py").write_text("# changed")
    else:
        (root / "alice/results/private_feature_evaluation.json").write_text("{}")
    with pytest.raises(ValueError):
        p.source_description(root, cfg)


def test_staging_has_no_host_array_export_and_only_new_owner(
    source, tmp_path, monkeypatch
):
    root, cfg = source
    calls = []
    monkeypatch.setattr(p.subprocess, 'check_output', lambda *a, **kw: 'synthetic-git-head\n')
    monkeypatch.setattr(
        p.phase.vm, "copy_to", lambda *args: calls.append(("copy", args))
    )
    monkeypatch.setattr(p, "guest", lambda text: calls.append(("guest", text)) or "")

    def python_guest(script):
        calls.append(("script", script))
        target = next((tmp_path / "new").glob("homecredit/*"))
        runtime = p.read(target / "alice/code/runtime.json")
        return json.dumps(
            dict(
                runtime,
                input_manifest_sha256="synthetic",
                source_inventory_sha256="synthetic",
            )
        )

    monkeypatch.setattr(p, "python_guest", python_guest)
    monkeypatch.setattr(p, 'firewall_receipt', lambda *a, **kw: None)
    target, run_id = p.stage(root, tmp_path / "new")
    rt = p.read(target / "alice/code/runtime.json")
    assert rt["account"] == p.ACCOUNT and rt["root"] == p.GUEST_BASE + "/" + run_id
    assert p.read(target / "declaration.json")["test_staged"] is False
    assert not list(target.rglob("*.npy")) and not list(target.rglob("*.npz"))
    setup = next(v for k, v in calls if k == "script")
    assert "old.rglob('*')" in setup and "is_symlink" in setup
    assert "'validation_local.npz'" in setup and "'train_local.npz'" not in setup
    assert "'bob'" not in setup and "shutil.copyfile(source_file,destination)" in setup
    assert all("/srv/vfl/alice/" not in v for k, v in calls if k == "guest")


@pytest.fixture
def analysis(tmp_path, monkeypatch):
    monkeypatch.setattr(p, 'firewall_receipt', lambda *a, **kw: None)
    root = tmp_path / "run"
    for name in ["code", "results", "logs"]:
        (root / "alice" / name).mkdir(parents=True)
    run_id = "homecredit_endpoint_diagnostic_20261015T123456Z"
    cfg = yaml.safe_load(p.CONFIG.read_text())
    code = root / "alice/code"
    (code / p.CONFIG.name).write_bytes(p.CONFIG.read_bytes())
    for name in p.CODE:
        (code / name).write_bytes((p.MODULE / "components" / name).read_bytes())
    rt = dict(
        run_id=run_id,
        root=p.GUEST_BASE + "/" + run_id,
        code_sha256={n: p.sha(code / n) for n in p.CODE},
        config_sha256=p.sha(p.CONFIG),
    )
    p.save(code / "runtime.json", rt)
    p.save(
        root / "alice/results/private_endpoint_diagnostics.json",
        dict(
            status="completed",
            source_replay=dict(passed=True),
            new_model_fits=0,
            paired_comparisons={k: {} for k in cfg["experiment"]["comparisons"]},
        ),
    )
    p.save(
        root / "alice/results/engineering.json",
        dict(nonroot=True, no_peer_data=True, row_values_exported=False),
    )
    p.save(
        root / "alice/results/party.executed.ipynb",
        dict(
            cells=[
                dict(cell_type="code", execution_count=i, outputs=[])
                for i in range(1, 4)
            ]
        ),
    )
    p.save(
        root / "alice/results/NOTEBOOK_COMPLETED.json",
        dict(status="passed", code_cells=3),
    )
    p.save(
        root / "status.json", dict(status="passed", exit_codes=[0], cleanup_errors=[])
    )
    return root, run_id


def test_verification_rechecks_entire_source_and_exact_export_inventory(
    analysis, monkeypatch
):
    root, run_id = analysis
    scripts = []
    monkeypatch.setattr(
        p, "python_guest", lambda script: scripts.append(script) or "source_unchanged"
    )
    assert p.verify(root, run_id)["source_unchanged"]
    assert "set(items['files'])" in scripts[0] and "items['directories']" in scripts[0]
    monkeypatch.setattr(p, "python_guest", lambda script: "changed")
    with pytest.raises(ValueError, match="source"):
        p.verify(root, run_id)


@pytest.mark.parametrize(
    "fault",
    [
        "status",
        "engineering",
        "notebook",
        "marker",
        "report",
        "array",
        "code",
        "config",
    ],
)
def test_export_admission_rejects_incomplete_or_forbidden_assets(
    analysis, monkeypatch, fault
):
    root, run_id = analysis
    monkeypatch.setattr(p, "verify_source", lambda rt: None)
    results = root / "alice/results"
    if fault == "status":
        p.save(root / "status.json", dict(status="failed", exit_codes=[0]))
    elif fault == "engineering":
        p.save(
            results / "engineering.json", dict(nonroot=False, row_values_exported=False)
        )
    elif fault == "notebook":
        p.save(results / "party.executed.ipynb", dict(cells=[]))
    elif fault == "marker":
        p.save(results / "NOTEBOOK_COMPLETED.json", {})
    elif fault == "report":
        value = p.read(results / "private_endpoint_diagnostics.json")
        value["new_model_fits"] = 1
        p.save(results / "private_endpoint_diagnostics.json", value)
    elif fault == "array":
        (results / "hidden.npy").write_bytes(b"synthetic forbidden export")
    elif fault == "code":
        (root / "alice/code/portfolio_math.py").write_text("# changed")
    else:
        (root / "alice/code" / p.CONFIG.name).write_text("{}")
    with pytest.raises(ValueError):
        p.verify(root, run_id)


@pytest.mark.parametrize(
    "fault",
    [None, "timeout", "execution", "interruption", "export", "cleanup", "verification"],
)
def test_execute_always_stops_remote_owner_and_records_failures(
    analysis, monkeypatch, fault
):
    root, run_id = analysis
    payloads = {n: (root / "alice/results" / n).read_text() for n in p.EXPORTS}
    for file in (root / "alice/results").iterdir():
        file.unlink()
    (root / "status.json").unlink()
    calls = []

    def run(command, **kwargs):
        calls.append(command)
        assert command[command.index("-u") + 1] == p.ACCOUNT and "-I" in command
        assert "hsbc-bob" not in command and kwargs["timeout"] > 0
        if fault == "timeout":
            raise subprocess.TimeoutExpired(command, 1)
        if fault == "interruption":
            raise KeyboardInterrupt()
        return SimpleNamespace(returncode=1 if fault == "execution" else 0)

    def guest(script):
        if fault == "export":
            raise OSError("export rejected")
        return payloads[script.rsplit("/", 1)[1]]

    cleaned = []

    def cleanup(runtime):
        cleaned.append(runtime["run_id"])
        if fault == "cleanup":
            raise RuntimeError("remote process remains")

    def verify(*args):
        if fault == "verification":
            raise ValueError("verification failed")
        return {"status": "passed"}

    monkeypatch.setattr(p.subprocess, "run", run)
    monkeypatch.setattr(p, "guest", guest)
    monkeypatch.setattr(p, "cleanup_owner", cleanup)
    monkeypatch.setattr(p, "verify", verify)
    if fault:
        with pytest.raises((Exception, KeyboardInterrupt)):
            p.execute(root, run_id)
    else:
        assert p.execute(root, run_id)["status"] == "passed"
    assert cleaned == [run_id]
    state = p.read(root / "status.json")
    assert state["status"] == ("failed" if fault else "passed")
    assert bool(state["cleanup_errors"]) == (fault == "cleanup")
    with pytest.raises(FileExistsError):
        p.execute(root, run_id)


def test_cleanup_uses_account_run_root_and_confirms_exit(monkeypatch):
    calls = []
    monkeypatch.setattr(
        p,
        "python_guest",
        lambda script: calls.append(script) or '{"owner_processes_stopped": true}',
    )
    rt = dict(run_id="homecredit_endpoint_diagnostic_20261015T123456Z")
    rt["root"] = p.GUEST_BASE + "/" + rt["run_id"]
    assert p.cleanup_owner(rt)["owner_processes_stopped"]
    assert "proc.stat().st_uid!=uid" in calls[0] and "assert not targets()" in calls[0]
    rt["root"] = "/srv/vfl/alice/old"
    with pytest.raises(ValueError):
        p.cleanup_owner(rt)


def test_firewall_requires_uid_rule_and_actual_counter_increment(monkeypatch):
    calls = []
    monkeypatch.setattr(p, 'python_guest', lambda script: calls.append(script) or 'firewall_verified')
    p.firewall_receipt({'root': '/new/synthetic'}, baseline=True)
    p.firewall_receipt({'root': '/new/synthetic'})
    assert "assert len(matches)==1" in calls[0]
    assert "current['ipv4']>previous['ipv4']" in calls[1]
    monkeypatch.setattr(p, 'python_guest', lambda script: 'unverified')
    with pytest.raises(ValueError):
        p.firewall_receipt({'root': '/new/synthetic'})
    rt.update(run_id="../../bad")
    with pytest.raises(ValueError):
        p.cleanup_owner(rt)


@pytest.mark.parametrize("failed", [False, True])
def test_queue_cannot_count_unfinished_diagnostics(tmp_path, monkeypatch, failed):
    cfg = yaml.safe_load(p.CONFIG.read_text())
    source = tmp_path / "source"
    source.mkdir()
    p.save(
        source / "status.json",
        dict(
            status="passed",
            completed=[f"/previous/{d}/source" for d in cfg["datasets"]],
        ),
    )
    monkeypatch.setattr(p, "stage", lambda s, o: (o / s.parent.name, "new_run"))

    def execute(*args):
        if failed:
            raise RuntimeError("owner incomplete")

    monkeypatch.setattr(p, "execute", execute)
    output = tmp_path / "new"
    if failed:
        with pytest.raises(RuntimeError):
            p.queue(source, output)
    else:
        assert p.queue(source, output)["status"] == "passed"
    state = p.read(output / "status.json")
    assert len(state["completed"]) == (0 if failed else cfg["expected_tasks"])
    p.save(source / "status.json", dict(status="failed", completed=[]))
    with pytest.raises(ValueError):
        p.queue(source, tmp_path / "bad")
